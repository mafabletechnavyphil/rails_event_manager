<% if resource.errors.any? %>
  <div class="bg-red-50 text-red-700 p-4 rounded-md border border-red-200 mb-2">
    <h2 class="font-semibold mb-2"><%= pluralize(resource.errors.count, "error") %> prohibited this user from being saved:</h2>
    <ul class="list-disc list-inside text-sm space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
