<%= form_with(model: event, class: "space-y-6 w-full") do |form| %>
  <% if event.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-md border border-red-200">
      <h2 class="font-semibold mb-2"><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul class="list-disc list-inside text-sm space-y-1">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :title, placeholder: "e.g., Annual Tech Meetup", class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :description, rows: 4, placeholder: "Describe what your event is about...", class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :location, placeholder: "e.g., Room 404, Innovation Hub or Zoom", class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :event_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.date_field :event_date, placeholder: "e.g., Room 404, Innovation Hub or Zoom", class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
    <%= form.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-md shadow-sm cursor-pointer transition" %>
    <%= link_to 'Cancel', events_path, class: "text-gray-600 hover:text-gray-900 font-medium text-sm" %>
  </div>

<% end %>
