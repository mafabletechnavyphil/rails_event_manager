<nav class="bg-white border-b border-gray-200 py-4 px-6 mb-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-8">
            <%= link_to "♦️ Rails Event", root_path, class: "text-xl font-bold text-gray-900" %>
            <% if user_signed_in? %>
                <%= link_to "Invited Events", invitations_path, class: "mr-auto text-sm font-medium text-gray-600 hover:text-gray-900" %>
            <% end %>
        </div>

        <div class="flex items-center gap-4 text-sm font-medium">
        <% if user_signed_in? %>
            <span class="text-gray-600">Logged in as: <strong class="text-gray-900"><%= current_user.email %></strong></span>
            <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "text-red-600 hover:text-red-700 bg-none cursor-pointer" %>
        <% else %>
            <%= link_to "Log In", new_user_session_path, class: "text-gray-600 hover:text-gray-900" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded transition" %>
        <% end %>
        </div>
    </div>
</nav>
